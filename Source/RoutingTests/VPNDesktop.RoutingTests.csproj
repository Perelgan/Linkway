<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MihomoExecutable Condition="'$(MihomoExecutable)' == '' and Exists('../../Libraries/mihomo.exe')">../../Libraries/mihomo.exe</MihomoExecutable>
    <MihomoExecutable Condition="'$(MihomoExecutable)' == ''">../dist/VPNDesktop/Libraries/mihomo.exe</MihomoExecutable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../VPNDesktop/VPNDesktop.csproj" />
    <None Include="$(MihomoExecutable)" Link="mihomo.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
