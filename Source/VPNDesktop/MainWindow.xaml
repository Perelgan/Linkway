                                        </DockPanel>
                                        <ComboBox x:Name="CoreBuilds" Style="{StaticResource RoutingSelect}" DisplayMemberPath="Label"
                                                  SelectionChanged="CoreBuildChanged" AutomationProperties.Name="Версия ядра Mihomo"/>
                                        <TextBlock x:Name="CoreUpdateStatus" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                                                   Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button x:Name="FindCoreBuildsButton" Content="Проверить версии ядра" Click="FindCoreBuilds" Margin="0,0,8,4"/>
                                            <Button x:Name="InstallCoreBuildButton" Content="Выбрать ядро" Click="InstallCoreBuild" Margin="0,0,0,4"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <Border Grid.Row="1" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}"
                    BorderThickness="0,1,0,0" Padding="30,12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=Message}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock x:Name="Message" Text="" Foreground="{DynamicResource Muted}" MinHeight="18"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </Border>
        </Grid>
    </Grid>
</Window>
