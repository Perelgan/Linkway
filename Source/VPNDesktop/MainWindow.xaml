                <StackPanel Grid.Row="1" AutomationProperties.Name="Разделы">
                    <RadioButton x:Name="ConnectionNav" GroupName="Navigation" Style="{StaticResource NavButton}"
                                 Checked="NavigationChanged" AutomationProperties.Name="Подключение">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource LucideDashboard}" Margin="0,0,11,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="Подключение" FontWeight="SemiBold"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="RoutingNav" GroupName="Navigation" Style="{StaticResource NavButton}"
                                 Checked="NavigationChanged" AutomationProperties.Name="Маршрутизация">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource LucideNetwork}" Margin="0,0,11,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="Маршрутизация" FontWeight="SemiBold"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ProfilesNav" GroupName="Navigation" Style="{StaticResource NavButton}"
                                 Checked="NavigationChanged" AutomationProperties.Name="Источники">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource LucideLayers}" Margin="0,0,11,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="Источники" FontWeight="SemiBold"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="CabinetNav" GroupName="Navigation" Style="{StaticResource NavButton}"
                                 Checked="NavigationChanged" AutomationProperties.Name="Аккаунт">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="M20,21 V19 A4,4 0 0 0 16,15 H8 A4,4 0 0 0 4,19 V21 M16,7 A4,4 0 1 1 8,7 A4,4 0 1 1 16,7"
                                  Margin="0,0,11,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="Аккаунт" FontWeight="SemiBold"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="SettingsNav" GroupName="Navigation" Style="{StaticResource NavButton}"
                                 Checked="NavigationChanged" AutomationProperties.Name="Настройки">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource LucideSettings}" Margin="0,0,11,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="Настройки" FontWeight="SemiBold"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                <Border Grid.Row="2" Background="{StaticResource Field}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="10" Padding="12,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource Muted}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ConnectionLabel" Text="Отключено" FontWeight="SemiBold"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                        <TextBlock Text="Mihomo 1.19.34" Foreground="{StaticResource Muted}" FontSize="12" Margin="15,0,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="30,28,30,24" MaxWidth="950">
                    <StackPanel x:Name="ConnectionPage" AutomationProperties.Name="Страница подключения">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Подключение"/>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,15" Padding="0"
                                Background="{StaticResource ConsoleSurface}">
                            <Grid ClipToBounds="True">
                                <Border Background="{StaticResource ConsoleDots}" CornerRadius="14" Opacity="0.48"
                                        IsHitTestVisible="False"/>
                                <Viewbox Stretch="Fill" Height="144" Margin="25,0" Opacity="0.48"
                                         VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Canvas Width="640" Height="146">
                                        <Path Stroke="{StaticResource Route}" StrokeThickness="1.2"
                                              Data="M 18,33 H 134 L 170,66 H 262 M 49,114 H 117 L 163,83 H 256 M 383,64 H 470 L 511,27 H 621 M 384,86 H 479 L 526,116 H 597"/>
                                        <Path Fill="{StaticResource Accent}" Data="M 18,29 A 4,4 0 1 0 18,37 A 4,4 0 1 0 18,29 M 49,110 A 4,4 0 1 0 49,118 A 4,4 0 1 0 49,110 M 621,23 A 4,4 0 1 0 621,31 A 4,4 0 1 0 621,23 M 597,112 A 4,4 0 1 0 597,120 A 4,4 0 1 0 597,112"/>
                                    </Canvas>
                                </Viewbox>
                                <StackPanel HorizontalAlignment="Center" Margin="18,16,18,19">
                                    <Grid Width="129" Height="129" HorizontalAlignment="Center">
                                        <Ellipse Fill="{StaticResource Field}" Opacity="0.44" Stroke="{StaticResource Accent}" StrokeThickness="1.2"/>
                                        <Ellipse Stroke="{StaticResource Route}" StrokeThickness="1" Margin="7"/>
                                        <Button x:Name="ConnectButton" Style="{StaticResource RoundAction}"
                                                Click="ToggleConnection" AutomationProperties.Name="Подключить">
                                            <Path x:Name="PowerIcon" Style="{StaticResource IconPath}" Width="37" Height="38"
                                                  Data="{StaticResource LucidePower}"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="2.8"/>
                                        </Button>
                                        <Button x:Name="OpenImportButton" Style="{StaticResource RoundAction}"
                                                Click="OpenProfiles" Visibility="Collapsed"
                                                ToolTip="Добавить ключ сервера или URL подписки"
                                                AutomationProperties.Name="Добавить сервер или подписку">
                                            <Path Style="{StaticResource IconPath}" Width="33" Height="33" Data="{StaticResource LucidePlus}"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="2.8"/>
                                        </Button>
                                    </Grid>
                                    <TextBlock x:Name="ConnectionHeadline" Text="Подключить" Margin="0,10,0,0"
                                               TextAlignment="Center" FontSize="23" FontWeight="SemiBold"/>
                                    <ContentControl x:Name="ConnectionDetail" ContentTemplate="{StaticResource FlaggedLabel}" Tag="Wrap"
                                                    HorizontalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,5,0,0" MaxWidth="370"/>
                                </StackPanel>
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Background="{StaticResource Field}"
                                        Padding="9,5" Margin="15" VerticalAlignment="Top" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource IconPath}" Width="13" Height="13" Data="{StaticResource LucideNetwork}"
                                              Stroke="{StaticResource Accent}" Margin="0,0,7,0"/>
                                        <TextBlock x:Name="ModeSummary" Text="PROXY" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <Border x:Name="ServerSelection" Style="{StaticResource Card}" Padding="17,15,17,14">
                            <StackPanel>
                                <DockPanel LastChildFill="True" Margin="3,0,3,11">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
                                        <Button x:Name="RefreshSubscriptionsButton" Click="RefreshSubscriptions" Margin="0,0,8,0"
                                                AutomationProperties.Name="Обновить подписки" ToolTipService.ShowOnDisabled="True">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource IconPath}" Data="{StaticResource LucideRefresh}" Margin="0,0,8,0"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                <TextBlock Text="Обновить подписки"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BulkCheckButton" MinWidth="127" Click="CheckAllServers"
                                                AutomationProperties.Name="Проверить все">
                                            <StackPanel Orientation="Horizontal">
                                                <Path x:Name="BulkCheckIcon" Style="{StaticResource IconPath}" Data="{StaticResource LucideActivity}"
                                                      Margin="0,0,8,0"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                <TextBlock x:Name="BulkCheckText" Text="Проверить все"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Серверы" FontSize="19" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ServerListSummary" Foreground="{StaticResource Muted}"
                                                   FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                    </StackPanel>
                                </DockPanel>
                                <ListBox x:Name="NodesList" AutomationProperties.Name="Серверы" SelectionChanged="NodeChanged"
                                         Style="{StaticResource DarkList}" Padding="3" MaxHeight="345"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ChoiceItem}">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="11,6"/>
                                            <Setter Property="Margin" Value="0,0,0,2"/>
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Node.Name}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="39">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="43"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="127"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="33" Height="33" CornerRadius="8" Background="{StaticResource Hover}"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource LucideServer}"
                                                          Stroke="{StaticResource Accent}" HorizontalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <ContentControl Content="{Binding Node.Name}" ToolTip="{Binding Node.Name}"
                                                                    ContentTemplate="{StaticResource FlaggedLabel}" FontSize="14" FontWeight="SemiBold"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding ProtocolLabel}" Foreground="{StaticResource Muted}" FontSize="12"/>
                                                        <TextBlock Text=" · Подключён" Foreground="{StaticResource Success}" FontSize="12">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border Grid.Column="2" Style="{StaticResource ServerStatus}" Margin="0,0,9,0"
                                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="12"/>
                                                </Border>
                                                <Button Grid.Column="3" Style="{StaticResource RowAction}" Content="Проверить"
                                                        Click="CheckServerRow" VerticalAlignment="Center"
                                                        AutomationProperties.Name="{Binding Node.Name, StringFormat='Проверить сервер {0}'}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ProfilesPage" Visibility="Collapsed" AutomationProperties.Name="Страница источников">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Источники"/>
                        <TextBlock x:Name="ProfilesLocked" Visibility="Collapsed" Foreground="{StaticResource Muted}"
                                   Text="Чтобы изменить источники, сначала отключите VPN." TextWrapping="Wrap" Margin="0,0,0,13"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Ключи и подписки"/>
                                    <ListBox x:Name="ProfilesList" DisplayMemberPath="Name" SelectionChanged="ProfileChanged"
                                             Style="{StaticResource DarkList}" ItemContainerStyle="{StaticResource ChoiceItem}"
                                             Height="155" AutomationProperties.Name="Добавленные ключи и подписки"/>
                                    <TextBlock x:Name="ProfileInfo" Text="Источников пока нет."
                                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,11,0,12"/>
                                    <WrapPanel>
                                        <Button x:Name="RefreshButton" Content="Обновить" Click="RefreshProfile" Margin="0,0,7,6"/>
                                        <Button x:Name="RemoveButton" Content="Удалить" Click="RemoveProfile" Margin="0,0,0,6"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Добавить источник"/>
                                    <TextBlock Style="{StaticResource Label}" Text="Ключ или URL подписки"/>
                                    <PasswordBox x:Name="SourceBox" MaxLength="65536" AutomationProperties.Name="Ключ или URL подписки"
                                                 Margin="0,0,0,13"/>
                                    <TextBlock Style="{StaticResource Label}" Text="Название (необязательно)"/>
                                    <TextBox x:Name="NameBox" MaxLength="100" AutomationProperties.Name="Название источника"/>
                                    <Button x:Name="ImportButton" Content="Добавить" Click="ImportProfile"
                                            HorizontalAlignment="Left" Margin="0,15,0,0" Style="{StaticResource PrimaryButton}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="CabinetPage" Visibility="Collapsed" AutomationProperties.Name="Страница аккаунта">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Аккаунт"/>
                        <Border Style="{StaticResource Card}" MaxWidth="530" HorizontalAlignment="Stretch">
                            <StackPanel>
                                <StackPanel x:Name="CabinetLoginForm">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Вход в Bedolaga Cabinet"/>
                                    <TextBlock Style="{StaticResource Label}" Text="Email"/>
                                    <TextBox x:Name="CabinetEmailBox" MaxLength="254"
                                             AutomationProperties.Name="Email" Margin="0,0,0,14"/>
                                    <TextBlock Style="{StaticResource Label}" Text="Пароль"/>
                                    <PasswordBox x:Name="CabinetPasswordBox" MaxLength="128"
                                                 AutomationProperties.Name="Пароль" KeyDown="CabinetPasswordKeyDown"/>
                                    <WrapPanel Margin="0,15,0,0">
                                        <Button Content="Войти" Style="{StaticResource PrimaryButton}"
                                                Click="LoginCabinetEmail" Margin="0,0,7,6"/>
                                        <Button Content="Войти через Telegram" Click="LoginCabinetTelegram" Margin="0,0,0,6"/>
                                    </WrapPanel>
                                </StackPanel>
                                <StackPanel x:Name="CabinetAccountActions" Visibility="Collapsed">
                                    <TextBlock x:Name="CabinetAccountName" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                                    <WrapPanel>
                                        <Button x:Name="SyncCabinetButton" Content="Обновить подписки"
                                                Click="RefreshCabinet" Margin="0,0,7,6"/>
                                        <Button x:Name="SignOutCabinetButton" Content="Выйти" Click="SignOutCabinet" Margin="0,0,0,6"/>
                                    </WrapPanel>
                                </StackPanel>
                                <Button x:Name="CancelTelegramLoginButton" Content="Отменить вход"
                                        Click="CancelTelegramLogin" Visibility="Collapsed" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="CabinetStatus" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                                           AutomationProperties.LiveSetting="Polite" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="RoutingPage" Visibility="Collapsed" AutomationProperties.Name="Страница маршрутизации">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Маршрутизация"/>
                        <StackPanel x:Name="RoutingEditor">
                            <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                <Button x:Name="RoutingApply" DockPanel.Dock="Right" Content="Применить"
                                        Style="{StaticResource PrimaryButton}" Click="ApplyRoutingProfile" Margin="10,0,0,0"
                                        ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Применить профиль"/>
                                <Button x:Name="RoutingProfileMenu" DockPanel.Dock="Right" Content="•••"
                                        Style="{StaticResource RouteAction}" Click="OpenRoutingProfileMenu" Margin="8,0,0,0"
                                        AutomationProperties.Name="Действия с профилем" ToolTip="Действия с профилем">
                                    <Button.ContextMenu>
                                        <ContextMenu Background="{StaticResource Panel}" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Line}">
                                            <MenuItem Header="Новый профиль" Click="NewRoutingProfile"/>
                                            <MenuItem Header="Переименовать" Click="RenameRoutingProfile"/>
                                            <Separator/>
                                            <MenuItem Header="Импорт…" Click="ImportRoutingProfile"/>
                                            <MenuItem Header="Экспорт…" Click="ExportRoutingProfile"/>
                                            <Separator/>
                                            <MenuItem x:Name="RoutingDeleteProfile" Header="Удалить профиль" Click="DeleteRoutingProfile"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <ComboBox x:Name="RoutingProfileBox" Style="{StaticResource RoutingSelect}" DisplayMemberPath="Name"
                                          SelectionChanged="RoutingProfileChanged" AutomationProperties.Name="Профиль маршрутизации"/>
                            </DockPanel>
                            <TextBlock x:Name="RoutingActiveLabel" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,17"/>
                        </StackPanel>
                        <Border BorderBrush="#242D42" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                            <WrapPanel>
                                <RadioButton x:Name="RoutingRulesTab" GroupName="RoutingTabs" Content="Правила" Style="{StaticResource RouteTab}" Checked="RoutingTabChanged"/>
                                <RadioButton x:Name="RoutingGroupsTab" GroupName="RoutingTabs" Content="Группы" Style="{StaticResource RouteTab}" Checked="RoutingTabChanged"/>
                                <RadioButton x:Name="RoutingConnectionsTab" GroupName="RoutingTabs" Content="Соединения" Style="{StaticResource RouteTab}" Checked="RoutingTabChanged"/>
                            </WrapPanel>
                        </Border>
                        <StackPanel x:Name="RoutingRulesPane" Margin="0,12,0,0">
                            <DockPanel LastChildFill="True">
                                <Button x:Name="RoutingAddRule" DockPanel.Dock="Right" Style="{StaticResource RouteAction}" Click="AddRoutingRule" Margin="9,0,0,0"
                                        AutomationProperties.Name="Добавить правило">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource LucidePlus}" Stroke="{StaticResource Accent}" Margin="0,0,7,0" Width="14" Height="14"/>
                                        <TextBlock Text="Добавить правило"/>
                                    </StackPanel>
                                </Button>
                                <Grid>
                                    <TextBox x:Name="RoutingRuleFilter" Height="38" MinHeight="0" Padding="12,8" MaxLength="256" VerticalContentAlignment="Center"
                                             TextChanged="RoutingFilterChanged" AutomationProperties.Name="Поиск по правилам">
                                        <TextBox.Template>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border x:Name="SearchSurface" Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ScrollViewer x:Name="PART_ContentHost"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="SearchSurface" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </TextBox.Template>
                                    </TextBox>
                                    <TextBlock Text="Поиск по правилам" Foreground="{StaticResource Muted}" Margin="13,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=RoutingRuleFilter}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DockPanel>
                            <TextBlock x:Name="RoutingRulesEmpty" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                       Padding="4,24,4,24"/>
                            <ListBox x:Name="RoutingRuleList" Style="{StaticResource RouteList}" ItemContainerStyle="{StaticResource RouteRow}"
                                     MaxHeight="465" Margin="0,8,0,0" SelectionChanged="RoutingRuleChanged" MouseDoubleClick="EditRoutingRule"
                                     AutomationProperties.Name="Правила профиля">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding Value}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="2*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Priority}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="12"/>
                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Condition}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <ContentControl Grid.Column="2" Content="{Binding Destination}" ContentTemplate="{StaticResource FlaggedLabel}"
                                                            Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel x:Name="RoutingRuleActions" Margin="0,7,0,0" Visibility="Collapsed">
                                <Button x:Name="RoutingEditRule" Content="Изменить" Style="{StaticResource RoutingAction}" Click="EditRoutingRule"/>
                                <Button x:Name="RoutingToggleRule" Content="Отключить" Style="{StaticResource RoutingAction}" Click="ToggleRoutingRule"/>
                                <Button x:Name="RoutingRemoveRule" Content="Удалить" Style="{StaticResource RoutingAction}" Click="RemoveRoutingRule"/>
                                <Button x:Name="RoutingUp" Content="↑" Style="{StaticResource RoutingAction}" Click="MoveRoutingRule"
                                        ToolTip="Выше" AutomationProperties.Name="Повысить приоритет"/>
                                <Button x:Name="RoutingDown" Content="↓" Style="{StaticResource RoutingAction}" Click="MoveRoutingRule"
                                        ToolTip="Ниже" AutomationProperties.Name="Понизить приоритет"/>
                            </WrapPanel>
                            <Border BorderBrush="#242D42" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="4,12,0,4">
                                <DockPanel LastChildFill="True">
                                    <Button x:Name="RoutingEditDefault" DockPanel.Dock="Right" Content="Изменить" Style="{StaticResource RouteAction}" Click="EditRoutingDefault"/>
                                    <StackPanel>
                                        <TextBlock Text="Остальной трафик" Foreground="{StaticResource Muted}" FontSize="12"/>
                                                        <ContentControl x:Name="RoutingDefaultLabel" ContentTemplate="{StaticResource FlaggedLabel}" Tag="Wrap" Margin="0,2,8,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="RoutingGroupsPane" Visibility="Collapsed" Margin="0,12,0,0">
                            <DockPanel Margin="0,0,0,6">
                                <Button x:Name="RoutingSubscriptionToggle" DockPanel.Dock="Right" Style="{StaticResource RouteAction}"
                                        Click="ToggleSubscriptionRouting" Margin="8,0,0,0"/>
                                <TextBlock Text="Группы из подписки" Style="{StaticResource SectionTitle}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="RoutingSubscriptionStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,0,0,8"/>
                            <WrapPanel Margin="0,0,0,6">
                                <Button x:Name="RoutingAddSubscriptionRule" Content="Добавить своё правило" Style="{StaticResource RouteAction}"
                                        Click="AddSubscriptionGroupRule" Margin="4,0,8,0" Visibility="Collapsed"/>
                                <Button x:Name="RoutingAssignSubscriptionRule" Content="Выбрать существующее правило" Style="{StaticResource RouteAction}"
                                        Click="AssignSubscriptionGroupRule" Visibility="Collapsed"/>
                            </WrapPanel>
                            <ListBox x:Name="RoutingSubscriptionGroups" Style="{StaticResource RouteList}" ItemContainerStyle="{StaticResource RouteRow}"
                                     MaxHeight="475" SelectionChanged="RoutingSubscriptionGroupChanged"
                                     AutomationProperties.Name="Группы из подписки">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Button Click="ToggleSubscriptionGroup" Style="{StaticResource GroupRouteButton}"
                                                    AutomationProperties.Name="{Binding Name}">
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock x:Name="GroupChevron" DockPanel.Dock="Right" Text="⌄" FontSize="16"
                                                               Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    <StackPanel>
                                                        <ContentControl Content="{Binding Name}" ContentTemplate="{StaticResource FlaggedLabel}" FontWeight="SemiBold" FontSize="14"/>
                                                        <ContentControl Content="{Binding Details}" ContentTemplate="{StaticResource FlaggedLabel}"
                                                                        Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                            <Border x:Name="GroupRoutes" Background="{StaticResource Field}" CornerRadius="10"
                                                    Padding="5" Margin="7,5,7,4" Visibility="Collapsed">
                                                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding Options}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Click="SelectSubscriptionRoute" Style="{StaticResource GroupRouteButton}"
                                                                        AutomationProperties.Name="{Binding Label}">
                                                                    <DockPanel LastChildFill="True">
                                                                        <TextBlock x:Name="SelectedMark" DockPanel.Dock="Right" Text="✓"
                                                                                   Foreground="{StaticResource Accent}" Visibility="Collapsed"/>
                                                                        <ContentControl Content="{Binding Label}" ContentTemplate="{StaticResource FlaggedLabel}" ToolTip="{Binding Label}"/>
                                                                    </DockPanel>
                                                                </Button>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding Selected}" Value="True">
                                                                        <Setter TargetName="SelectedMark" Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="GroupRoutes" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="GroupChevron" Property="Text" Value="⌃"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <StackPanel x:Name="RoutingConnectionsPane" Visibility="Collapsed" Margin="0,12,0,0">
                            <Button x:Name="RoutingRuleFromConnection" Content="Создать правило" Style="{StaticResource RouteAction}"
                                    HorizontalAlignment="Right" Click="AddRuleFromConnection" AutomationProperties.Name="Создать правило из соединения"/>
                            <TextBlock x:Name="RoutingMonitorStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,8,0,8"/>
                            <ListBox x:Name="RoutingConnectionList" Style="{StaticResource RouteList}" ItemContainerStyle="{StaticResource RouteRow}"
                                     MaxHeight="465" SelectionChanged="RoutingConnectionChanged" AutomationProperties.Name="Активные соединения Mihomo">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Destination}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Details}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <TextBlock x:Name="RoutingModeNote" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="4,15,0,0"/>
                    </StackPanel>

                    <StackPanel x:Name="SettingsPage" Visibility="Collapsed" AutomationProperties.Name="Страница настроек">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Настройки"/>
                        <TextBlock x:Name="SettingsLocked" Visibility="Collapsed" Foreground="{StaticResource Muted}"
                                   Text="Чтобы изменить режим или маршрутизацию, сначала отключите VPN." TextWrapping="Wrap" Margin="0,0,0,13"/>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Режим подключения"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="ProxyMode" GroupName="ConnectionMode" Style="{StaticResource ModeCard}"
                                                 Checked="ModeChanged" AutomationProperties.Name="PROXY">
                                        <StackPanel>
                                            <TextBlock Text="PROXY" FontWeight="SemiBold" FontSize="15"/>
                                            <TextBlock Text="Для приложений, которые используют системный прокси Windows."
                                                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="TunMode" Grid.Column="2" GroupName="ConnectionMode"
                                                 Style="{StaticResource ModeCard}" Checked="ModeChanged" AutomationProperties.Name="TUN">
                                        <StackPanel>
                                            <TextBlock Text="TUN" FontWeight="SemiBold" FontSize="15"/>
                                            <TextBlock Text="Трафик Windows через виртуальный адаптер. Нужен запуск от имени администратора."
                                                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </RadioButton>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Маршрутизация"/>
                                <CheckBox x:Name="BypassLan" Content="Локальная сеть напрямую"
                                          Style="{StaticResource SettingToggle}" Checked="ModeChanged" Unchecked="ModeChanged"/>
                                <TextBlock Text="Трафик к локальным адресам проходит мимо VPN."
                                           Foreground="{StaticResource Muted}" Margin="44,6,0,0" TextWrapping="Wrap"/>
                                <CheckBox x:Name="KillSwitchToggle" Content="Kill Switch"
                                          Style="{StaticResource SettingToggle}" Checked="ModeChanged" Unchecked="ModeChanged" Margin="0,16,0,0"/>
                                <TextBlock x:Name="KillSwitchNote" Foreground="{StaticResource Muted}" Margin="44,6,0,0" TextWrapping="Wrap"/>
                                <Button x:Name="KillSwitchRelease" Content="Снять блокировку сети" Click="ReleaseKillSwitch"
                                        Style="{StaticResource RouteAction}" HorizontalAlignment="Left" Margin="44,10,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel LastChildFill="True" Margin="0,0,0,15">
                                    <Border DockPanel.Dock="Right" Padding="9,4" CornerRadius="7" Background="{StaticResource Selected}">
                                        <TextBlock x:Name="AppVersionLabel" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Обновления" Margin="0"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Label}" Text="Репозиторий GitHub"/>
                                <DockPanel LastChildFill="True">
                                    <Button x:Name="SaveRepositoryButton" DockPanel.Dock="Right" Content="Сохранить"
                                            Margin="8,0,0,0" Click="SaveRepository"/>
                                    <TextBox x:Name="RepositoryBox" MaxLength="350" TextChanged="RepositoryChanged"
                                             AutomationProperties.Name="Репозиторий GitHub" ToolTip="https://github.com/owner/repository"/>
                                </DockPanel>
                                <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                                           Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
                                <WrapPanel Margin="0,13,0,0">
                                    <Button x:Name="CheckUpdateButton" Content="Проверить обновления" Click="CheckForUpdates"
                                            Margin="0,0,8,4"/>
                                    <Button x:Name="InstallUpdateButton" Content="Скачать и установить" Click="DownloadUpdate"
                                            Visibility="Collapsed" Margin="0,0,0,4" Style="{StaticResource PrimaryButton}"
                                            ToolTipService.ShowOnDisabled="True"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <Border Grid.Row="1" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}"
                    BorderThickness="0,1,0,0" Padding="30,12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=Message}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock x:Name="Message" Text="" Foreground="{StaticResource Muted}" MinHeight="18"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </Border>
        </Grid>
    </Grid>
</Window>
