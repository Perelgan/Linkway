<Window x:Class="VPNDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VPNDesktop"
        Title="VPN Desktop" Width="1030" Height="710" MinWidth="790" MinHeight="530"
        WindowStartupLocation="CenterScreen" Background="#0C101C" Foreground="#F1F2FF"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
    <Window.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="IconGeometry.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="Sidebar" Color="#121725"/>
        <SolidColorBrush x:Key="Panel" Color="#161C2E"/>
        <SolidColorBrush x:Key="Field" Color="#101625"/>
        <SolidColorBrush x:Key="Line" Color="#303953"/>
        <SolidColorBrush x:Key="Ink" Color="#F1F2FF"/>
        <SolidColorBrush x:Key="Muted" Color="#A7AFCB"/>
        <SolidColorBrush x:Key="Accent" Color="#B5ABFF"/>
        <SolidColorBrush x:Key="Selected" Color="#292745"/>
        <SolidColorBrush x:Key="Hover" Color="#222B42"/>
        <SolidColorBrush x:Key="SelectionLine" Color="#7165A9"/>
        <SolidColorBrush x:Key="Success" Color="#80E1B0"/>
        <SolidColorBrush x:Key="ConnectedFill" Color="#17372F"/>
        <SolidColorBrush x:Key="StatusWarning" Color="#F3BE98"/>
        <SolidColorBrush x:Key="WarningFill" Color="#372B30"/>
        <SolidColorBrush x:Key="Route" Color="#62669D"/>
        <local:CountryFlagLabelConverter x:Key="CountryFlagLabel"/>
        <DataTemplate x:Key="FlaggedLabel">
            <DockPanel LastChildFill="True">
                <Image x:Name="FlagGlyph" DockPanel.Dock="Left" Width="18" Height="13" Stretch="Uniform"
                       Margin="0,0,6,0" VerticalAlignment="Center"
                       Source="{Binding Converter={StaticResource CountryFlagLabel}, ConverterParameter=Flag}"/>
                <TextBlock x:Name="FlagText" Text="{Binding Converter={StaticResource CountryFlagLabel}}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <DataTemplate.Triggers>
                <Trigger SourceName="FlagGlyph" Property="Image.Source" Value="{x:Null}">
                    <Setter TargetName="FlagGlyph" Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}" Value="Wrap">
                    <Setter TargetName="FlagText" Property="TextWrapping" Value="Wrap"/>
                    <Setter TargetName="FlagText" Property="TextTrimming" Value="None"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="FlaggedChoice">
            <ContentControl Content="{Binding Label}" ContentTemplate="{StaticResource FlaggedLabel}"/>
        </DataTemplate>
        <LinearGradientBrush x:Key="ConsoleSurface" StartPoint="0,0" EndPoint="1,0.85">
            <GradientStop Color="#17233C" Offset="0"/>
            <GradientStop Color="#1A1C37" Offset="0.52"/>
            <GradientStop Color="#241F3D" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PowerFill" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#D6CDFF" Offset="0"/>
            <GradientStop Color="#B3A6FD" Offset="0.57"/>
            <GradientStop Color="#9C8DE8" Offset="1"/>
        </LinearGradientBrush>
        <DrawingBrush x:Key="ConsoleDots" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,19,19">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,19,19"/></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#536285">
                        <GeometryDrawing.Geometry><EllipseGeometry Center="9.5,9.5" RadiusX="0.9" RadiusY="0.9"/></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,17"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="22"/>
        </Style>
        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="{StaticResource Hover}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.83"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.68"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Ink}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.54"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#211D38"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="RowAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="RoutingAction" TargetType="Button" BasedOn="{StaticResource RowAction}">
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
        <Style x:Key="RouteAction" TargetType="Button" BasedOn="{StaticResource RowAction}">
            <Setter Property="Background" Value="#171F32"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style x:Key="GroupRouteButton" TargetType="Button" BasedOn="{StaticResource RowAction}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderThickness="1"
                                BorderBrush="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RouteTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Tab" Background="Transparent" CornerRadius="12" Padding="{TemplateBinding Padding}"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="{StaticResource Selected}"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="PageBack" Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="22" MinWidth="6">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbSurface" Background="{StaticResource Line}" CornerRadius="4" Margin="1"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbSurface" Property="Background" Value="{StaticResource Route}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbSurface" Property="Background" Value="{StaticResource Accent}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="PageForward" Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                <Setter TargetName="PageBack" Property="Command" Value="ScrollBar.PageLeftCommand"/>
                                <Setter TargetName="PageForward" Property="Command" Value="ScrollBar.PageRightCommand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="9"/>
                    <Setter Property="Width" Value="Auto"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RouteRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border BorderBrush="#242D42" BorderThickness="0,0,0,1" Padding="0,2">
                            <Border x:Name="Row" CornerRadius="10" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="10,8">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Selected}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoutingSelect" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Item" Background="Transparent" Padding="10,6">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Item" Property="Background" Value="{StaticResource Hover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Item" Property="Background" Value="{StaticResource Selected}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Field" CornerRadius="7" Background="{StaticResource Field}"
                                                BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10,0">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Data="M0,0 L4,4 8,0"
                                                  Stroke="{StaticResource Muted}" StrokeThickness="1.5"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="10,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False">
                                <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                        CornerRadius="7" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxWidth="620" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ServerStatus" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Hover}"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CheckState}" Value="Available">
                    <Setter Property="Background" Value="{StaticResource ConnectedFill}"/>
                    <Setter Property="TextElement.Foreground" Value="{StaticResource Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CheckState}" Value="Unavailable">
                    <Setter Property="Background" Value="{StaticResource WarningFill}"/>
                    <Setter Property="TextElement.Foreground" Value="{StaticResource StatusWarning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CheckState}" Value="Error">
                    <Setter Property="Background" Value="{StaticResource WarningFill}"/>
                    <Setter Property="TextElement.Foreground" Value="{StaticResource StatusWarning}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RoundAction" TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="Foreground" Value="#211D38"/>
            <Setter Property="Background" Value="{StaticResource PowerFill}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Disc" Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.5"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Disc" Property="Opacity" Value="0.84"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Disc" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Disc" Property="Stroke" Value="{StaticResource Ink}"/>
                                <Setter TargetName="Disc" Property="StrokeThickness" Value="3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Disc" Property="Opacity" Value="0.52"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Height" Value="47"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Nav" Background="Transparent" CornerRadius="8"
                                BorderBrush="Transparent" BorderThickness="1" Padding="12,0">
                            <Grid>
                                <Border x:Name="Marker" Width="3" Height="20" CornerRadius="1.5"
                                        Background="{StaticResource Accent}" HorizontalAlignment="Left"
                                        Margin="-10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Nav" Property="Background" Value="{StaticResource Hover}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Nav" Property="Background" Value="{StaticResource Selected}"/>
                                <Setter TargetName="Marker" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Nav" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModeCard" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Outline" Padding="14" CornerRadius="9" BorderThickness="1"
                                Background="{StaticResource Field}" BorderBrush="{StaticResource Line}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,3,0,0">
                                    <Ellipse x:Name="Ring" Stroke="{StaticResource Muted}" StrokeThickness="1.4"/>
                                    <Ellipse x:Name="SelectedDot" Width="7" Height="7" Fill="{StaticResource Accent}" Visibility="Collapsed"/>
                                </Grid>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Top"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outline" Property="Background" Value="{StaticResource Hover}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Outline" Property="Background" Value="{StaticResource Selected}"/>
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Accent}"/>
                                <Setter TargetName="SelectedDot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource Ink}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Outline" Property="Opacity" Value="0.70"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingToggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <DockPanel Background="Transparent">
                            <Border x:Name="Track" DockPanel.Dock="Left" Width="34" Height="20" CornerRadius="10"
                                    Background="{StaticResource Hover}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Ellipse x:Name="Thumb" Width="12" Height="12" HorizontalAlignment="Left"
                                         Fill="{StaticResource Muted}" Margin="3,0"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Selected}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Ink}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.57"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="{StaticResource Field}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Ink}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="MinHeight" Value="40"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="{StaticResource Field}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Ink}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="MinHeight" Value="40"/>
        </Style>
        <Style x:Key="DarkList" TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource Field}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ScrollViewer" Focusable="False" CanContentScroll="True"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RouteList" TargetType="ListBox" BasedOn="{StaticResource DarkList}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        </Style>
        <Style x:Key="ChoiceItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Choice" Background="Transparent" Padding="{TemplateBinding Padding}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="5">
                            <ContentPresenter ClipToBounds="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Choice" Property="Background" Value="{StaticResource Hover}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Choice" Property="Background" Value="{StaticResource Selected}"/>
                                <Setter TargetName="Choice" Property="BorderBrush" Value="{StaticResource SelectionLine}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ApplicationPickerRow">
            <Grid ToolTip="{Binding Path}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="33"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Left"
                        Background="{StaticResource Hover}" CornerRadius="6">
                    <Grid>
                        <Path x:Name="DefaultApplicationIcon" Style="{StaticResource IconPath}" Data="{StaticResource LucideDashboard}"
                              Stroke="{StaticResource Muted}" Width="14" Height="14" HorizontalAlignment="Center" Visibility="Collapsed"/>
                        <Image Width="20" Height="20" Source="{Binding Icon}" Stretch="Uniform"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Path}" Foreground="{StaticResource Muted}" FontSize="11"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                    <Setter TargetName="DefaultApplicationIcon" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
      </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="204"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <Grid Margin="15,23,15,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="5,2,0,30">
                    <Border Background="{StaticResource Selected}" CornerRadius="10" Width="38" Height="38"
                            BorderThickness="1" BorderBrush="{StaticResource SelectionLine}">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource LucideShield}" Stroke="{StaticResource Accent}"
                              Width="19" Height="21" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="VPN Desktop" FontSize="17" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
