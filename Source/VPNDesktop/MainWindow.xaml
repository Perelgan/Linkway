<Window x:Class="VPNDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VPNDesktop"
        Title="Linkway" Icon="Assets/Linkway.ico" Width="1120" Height="765" MinWidth="790" MinHeight="530"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
    <Window.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="IconGeometry.xaml"/>
            <ResourceDictionary Source="ThemeDark.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <local:CountryFlagLabelConverter x:Key="CountryFlagLabel"/>
        <DataTemplate x:Key="FlaggedLabel">
            <DockPanel LastChildFill="True">
                <Image x:Name="FlagGlyph" DockPanel.Dock="Left" Width="18" Height="13" Stretch="Uniform"
                       Margin="0,0,6,0" VerticalAlignment="Center"
                       Source="{Binding Converter={StaticResource CountryFlagLabel}, ConverterParameter=Flag}"/>
                <TextBlock x:Name="FlagText" Text="{Binding Converter={StaticResource CountryFlagLabel}}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <DataTemplate.Triggers>
                <Trigger SourceName="FlagGlyph" Property="Image.Source" Value="{x:Null}">
                    <Setter TargetName="FlagGlyph" Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}" Value="Wrap">
                    <Setter TargetName="FlagText" Property="TextWrapping" Value="Wrap"/>
                    <Setter TargetName="FlagText" Property="TextTrimming" Value="None"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="FlaggedChoice">
            <ContentControl Content="{Binding Label}" ContentTemplate="{StaticResource FlaggedLabel}"/>
        </DataTemplate>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,17"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="22"/>
        </Style>
        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Background" Value="{DynamicResource Hover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.83"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.68"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Ink}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.54"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryInk}"/>
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="RowAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="RoutingAction" TargetType="Button" BasedOn="{StaticResource RowAction}">
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
        <Style x:Key="RouteAction" TargetType="Button" BasedOn="{StaticResource RowAction}">
            <Setter Property="Background" Value="{DynamicResource Selected}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style x:Key="GroupRouteButton" TargetType="Button" BasedOn="{StaticResource RowAction}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderThickness="1"
                                BorderBrush="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseActionOption" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Background" Value="{DynamicResource Field}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="OptionSurface" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="17" Height="17" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Ellipse x:Name="OptionRing" Fill="{TemplateBinding Background}"
                                             Stroke="{DynamicResource Muted}" StrokeThickness="1.5"/>
                                    <Ellipse x:Name="OptionMark" Width="7" Height="7"
                                             Fill="{DynamicResource Accent}" Visibility="Collapsed"/>
                                </Grid>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OptionSurface" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OptionSurface" Property="Background" Value="{DynamicResource Selected}"/>
                                <Setter TargetName="OptionRing" Property="Stroke" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="OptionMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="OptionSurface" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                                <Setter TargetName="OptionSurface" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RouteTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Tab" Background="Transparent" CornerRadius="12" Padding="{TemplateBinding Padding}"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="{DynamicResource Selected}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="PageBack" Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="22" MinWidth="6">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbSurface" Background="{DynamicResource Line}" CornerRadius="4" Margin="1"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource Route}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource Accent}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="PageForward" Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                <Setter TargetName="PageBack" Property="Command" Value="ScrollBar.PageLeftCommand"/>
                                <Setter TargetName="PageForward" Property="Command" Value="ScrollBar.PageRightCommand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="9"/>
                    <Setter Property="Width" Value="Auto"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RouteRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,2">
                            <Border x:Name="Row" CornerRadius="10" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="10,8">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Selected}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoutingSelect" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Item" Background="Transparent" Padding="10,6">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Item" Property="Background" Value="{DynamicResource Hover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Item" Property="Background" Value="{DynamicResource Selected}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Field" CornerRadius="7" Background="{DynamicResource Field}"
                                                BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="10,0">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Data="M0,0 L4,4 8,0"
                                                  Stroke="{DynamicResource Muted}" StrokeThickness="1.5"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="10,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False">
                                <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                        CornerRadius="7" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxWidth="620" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ServerStatus" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Hover}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CheckState}" Value="Available">
                    <Setter Property="Background" Value="{DynamicResource ConnectedFill}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CheckState}" Value="Unavailable">
                    <Setter Property="Background" Value="{DynamicResource WarningFill}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource StatusWarning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CheckState}" Value="Error">
                    <Setter Property="Background" Value="{DynamicResource WarningFill}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource StatusWarning}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RoundAction" TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryInk}"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryFill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Disc" Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.5"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Disc" Property="Opacity" Value="0.84"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Disc" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Disc" Property="Stroke" Value="{DynamicResource Ink}"/>
                                <Setter TargetName="Disc" Property="StrokeThickness" Value="3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Disc" Property="Opacity" Value="0.52"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Height" Value="47"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Nav" Background="Transparent" CornerRadius="8"
                                BorderBrush="Transparent" BorderThickness="1" Padding="12,0">
                            <Grid>
                                <Border x:Name="Marker" Width="3" Height="20" CornerRadius="1.5"
                                        Background="{DynamicResource Accent}" HorizontalAlignment="Left"
                                        Margin="-10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Nav" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Nav" Property="Background" Value="{DynamicResource Selected}"/>
                                <Setter TargetName="Marker" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Nav" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModeCard" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Outline" Padding="14" CornerRadius="9" BorderThickness="1"
                                Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,3,0,0">
                                    <Ellipse x:Name="Ring" Stroke="{DynamicResource Muted}" StrokeThickness="1.4"/>
                                    <Ellipse x:Name="SelectedDot" Width="7" Height="7" Fill="{DynamicResource Accent}" Visibility="Collapsed"/>
                                </Grid>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Top"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outline" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Outline" Property="Background" Value="{DynamicResource Selected}"/>
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="SelectedDot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource Ink}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Outline" Property="Opacity" Value="0.70"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingToggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <DockPanel Background="Transparent">
                            <Border x:Name="Track" DockPanel.Dock="Left" Width="34" Height="20" CornerRadius="10"
                                    Background="{DynamicResource Hover}" BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Ellipse x:Name="Thumb" Width="12" Height="12" HorizontalAlignment="Left"
                                         Fill="{DynamicResource Muted}" Margin="3,0"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Selected}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Ink}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.57"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Background" Value="{DynamicResource Field}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="MinHeight" Value="40"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Background" Value="{DynamicResource Field}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="MinHeight" Value="40"/>
        </Style>
        <Style x:Key="DarkList" TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource Field}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ScrollViewer" Focusable="False" CanContentScroll="True"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RouteList" TargetType="ListBox" BasedOn="{StaticResource DarkList}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        </Style>
        <Style x:Key="ChoiceItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Choice" Background="Transparent" Padding="{TemplateBinding Padding}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="5">
                            <ContentPresenter ClipToBounds="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Choice" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Choice" Property="Background" Value="{DynamicResource Selected}"/>
                                <Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource SelectionLine}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ApplicationPickerRow">
            <Grid ToolTip="{Binding Path}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="33"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Left"
                        Background="{DynamicResource Hover}" CornerRadius="6">
                    <Grid>
                        <Path x:Name="DefaultApplicationIcon" Style="{StaticResource IconPath}" Data="{StaticResource LucideDashboard}"
                              Stroke="{DynamicResource Muted}" Width="14" Height="14" HorizontalAlignment="Center" Visibility="Collapsed"/>
                        <Image Width="20" Height="20" Source="{Binding Icon}" Stretch="Uniform"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Path}" Foreground="{DynamicResource Muted}" FontSize="11"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                    <Setter TargetName="DefaultApplicationIcon" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
      </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="204"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <Grid Margin="15,23,15,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="5,2,0,30">
                    <Image Source="Assets/Linkway.png" Width="38" Height="38" AutomationProperties.Name="Linkway"/>
                    <TextBlock Text="Linkway" FontSize="17" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" AutomationProperties.Name="Разделы">
                    <RadioButton x:Name="ConnectionNav" GroupName="Navigation" Style="{StaticResource NavButton}"
                                 Checked="NavigationChanged" AutomationProperties.Name="Подключение">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource LucideDashboard}" Margin="0,0,11,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="Подключение" FontWeight="SemiBold"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="RoutingNav" GroupName="Navigation" Style="{StaticResource NavButton}"
                                 Checked="NavigationChanged" AutomationProperties.Name="Маршрутизация">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource LucideNetwork}" Margin="0,0,11,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="Маршрутизация" FontWeight="SemiBold"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ProfilesNav" GroupName="Navigation" Style="{StaticResource NavButton}"
                                 Checked="NavigationChanged" AutomationProperties.Name="Источники">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource LucideLayers}" Margin="0,0,11,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="Источники" FontWeight="SemiBold"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="CabinetNav" GroupName="Navigation" Style="{StaticResource NavButton}"
                                 Checked="NavigationChanged" AutomationProperties.Name="Аккаунт">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="M20,21 V19 A4,4 0 0 0 16,15 H8 A4,4 0 0 0 4,19 V21 M16,7 A4,4 0 1 1 8,7 A4,4 0 1 1 16,7"
                                  Margin="0,0,11,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="Аккаунт" FontWeight="SemiBold"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="DiagnosticsNav" GroupName="Navigation" Style="{StaticResource NavButton}"
                                 Checked="NavigationChanged" AutomationProperties.Name="Диагностика">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource LucideActivity}" Margin="0,0,11,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="Диагностика" FontWeight="SemiBold"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="SettingsNav" GroupName="Navigation" Style="{StaticResource NavButton}"
                                 Checked="NavigationChanged" AutomationProperties.Name="Настройки">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource LucideSettings}" Margin="0,0,11,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="Настройки" FontWeight="SemiBold"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                <Border Grid.Row="2" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line}"
                        BorderThickness="1" CornerRadius="10" Padding="12,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource Muted}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ConnectionLabel" Text="Отключено" FontWeight="SemiBold"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                        <TextBlock x:Name="SidebarSpeed" Text="↓ 0 Б/с   ↑ 0 Б/с" Foreground="{DynamicResource Muted}"
                                   FontSize="12" Margin="15,0,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="30,28,30,24" MaxWidth="950">
                    <StackPanel x:Name="ConnectionPage" AutomationProperties.Name="Страница подключения">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Подключение"/>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,15" Padding="0"
                                Background="{DynamicResource Panel}">
                            <Grid ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel HorizontalAlignment="Stretch" Margin="18,24,18,22">
                                    <Grid Width="129" Height="129" HorizontalAlignment="Center">
                                        <Ellipse Fill="{DynamicResource Field}" Opacity="0.44" Stroke="{DynamicResource Accent}" StrokeThickness="1.2"/>
                                        <Ellipse Stroke="{DynamicResource Route}" StrokeThickness="1" Margin="7"/>
                                        <Button x:Name="ConnectButton" Style="{StaticResource RoundAction}"
                                                Click="ToggleConnection" AutomationProperties.Name="Подключить" RenderTransformOrigin="0.5,0.5">
                                            <Button.RenderTransform>
                                                <ScaleTransform x:Name="ConnectionButtonScale" ScaleX="1" ScaleY="1"/>
                                            </Button.RenderTransform>
                                            <Path x:Name="PowerIcon" Style="{StaticResource IconPath}" Width="37" Height="38"
                                                  Data="{StaticResource LucidePower}"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="2.8"/>
                                        </Button>
                                        <Button x:Name="OpenImportButton" Style="{StaticResource RoundAction}"
                                                Click="OpenProfiles" Visibility="Collapsed"
                                                ToolTip="Добавить ключ сервера или URL подписки"
                                                AutomationProperties.Name="Добавить сервер или подписку">
                                            <Path Style="{StaticResource IconPath}" Width="33" Height="33" Data="{StaticResource LucidePlus}"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="2.8"/>
                                        </Button>
                                    </Grid>
                                    <TextBlock x:Name="ConnectionHeadline" Text="Подключить" Margin="0,10,0,0"
                                               TextAlignment="Center" FontSize="23" FontWeight="SemiBold"/>
                                    <ContentControl x:Name="ConnectionDetail" ContentTemplate="{StaticResource FlaggedLabel}" Tag="Wrap"
                                                    HorizontalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" MaxWidth="370"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,20,18,20">
                                    <WrapPanel Margin="0,0,0,13">
                                        <RadioButton x:Name="DashboardProxy" Content="PROXY" GroupName="DashboardMode" Style="{StaticResource RouteTab}" Checked="DashboardModeChanged"/>
                                        <RadioButton x:Name="DashboardTun" Content="TUN" GroupName="DashboardMode" Style="{StaticResource RouteTab}" Checked="DashboardModeChanged"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="DashboardSubscription" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                    <CheckBox x:Name="AutomaticServerToggle" Style="{StaticResource SettingToggle}"
                                              Content="Автовыбор по задержке" Margin="0,8,0,0"
                                              ToolTip="Выбирать доступный сервер из выбранного источника и переключаться при сбое."
                                              Click="AutomaticServerChanged"/>
                                    <TextBlock x:Name="AutomaticServerStatus" Foreground="{DynamicResource Muted}"
                                               Margin="0,4,0,3" TextWrapping="Wrap" Visibility="Collapsed"
                                               AutomationProperties.LiveSetting="Polite"/>
                                    <TextBlock x:Name="DashboardSession" Margin="0,4,0,3" Foreground="{DynamicResource Muted}"/>
                                    <TextBlock x:Name="DashboardPing" Visibility="Collapsed" Foreground="{DynamicResource Muted}"/>
                                    <local:TrafficChart x:Name="DashboardChart" Height="54" Margin="0,6,0,0"
                                                        Foreground="{DynamicResource Accent}" Background="{DynamicResource Line}"
                                                        AutomationProperties.Name="График скорости за последнюю минуту"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border x:Name="ServerSelection" Style="{StaticResource Card}" Padding="17,15,17,14">
                            <StackPanel>
                                <DockPanel LastChildFill="True" Margin="3,0,3,11">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
                                        <Button x:Name="RefreshSubscriptionsButton" Click="RefreshSubscriptions" Margin="0,0,8,0"
                                                AutomationProperties.Name="Обновить подписки" ToolTipService.ShowOnDisabled="True">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource IconPath}" Data="{StaticResource LucideRefresh}" Margin="0,0,8,0"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                <TextBlock Text="Обновить подписки"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BulkCheckButton" MinWidth="127" Click="CheckAllServers"
                                                AutomationProperties.Name="Проверить все" ToolTip="Измерить задержку TCP напрямую до каждого сервера">
                                            <StackPanel Orientation="Horizontal">
                                                <Path x:Name="BulkCheckIcon" Style="{StaticResource IconPath}" Data="{StaticResource LucideActivity}"
                                                      Margin="0,0,8,0"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                <TextBlock x:Name="BulkCheckText" Text="Проверить все"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Серверы" FontSize="19" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ServerListSummary" Foreground="{DynamicResource Muted}"
                                                   FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                    </StackPanel>
                                </DockPanel>
                                <ListBox x:Name="NodesList" AutomationProperties.Name="Серверы" SelectionChanged="NodeChanged"
                                         Style="{StaticResource DarkList}" Padding="3" MaxHeight="345"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ChoiceItem}">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="11,6"/>
                                            <Setter Property="Margin" Value="0,0,0,2"/>
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Node.Name}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="39">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="43"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="127"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="33" Height="33" CornerRadius="8" Background="{DynamicResource Hover}"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource LucideServer}"
                                                          Stroke="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <ContentControl Content="{Binding Node.Name}" ToolTip="{Binding Node.Name}"
                                                                    ContentTemplate="{StaticResource FlaggedLabel}" FontSize="14" FontWeight="SemiBold"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding ProtocolLabel}" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                                        <TextBlock Text=" · Подключён" Foreground="{DynamicResource Success}" FontSize="12">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border Grid.Column="2" Style="{StaticResource ServerStatus}" Margin="0,0,9,0"
                                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="12"/>
                                                </Border>
                                                <Button Grid.Column="3" Style="{StaticResource RowAction}" Content="Проверить"
                                                        Click="CheckServerRow" VerticalAlignment="Center"
                                                        ToolTip="Измерить задержку TCP напрямую до сервера"
                                                        AutomationProperties.Name="{Binding Node.Name, StringFormat='Проверить сервер {0}'}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ProfilesPage" Visibility="Collapsed" AutomationProperties.Name="Страница источников">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Источники"/>
                        <TextBlock x:Name="ProfilesLocked" Visibility="Collapsed" Foreground="{DynamicResource Muted}"
                                   Text="Чтобы изменить источники, сначала отключите VPN." TextWrapping="Wrap" Margin="0,0,0,13"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Ключи и подписки"/>
                                    <ListBox x:Name="ProfilesList" DisplayMemberPath="Name" SelectionChanged="ProfileChanged"
                                             Style="{StaticResource DarkList}" ItemContainerStyle="{StaticResource ChoiceItem}"
                                             Height="155" AutomationProperties.Name="Добавленные ключи и подписки"/>
                                    <TextBlock x:Name="ProfileInfo" Text="Источников пока нет."
                                               Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,11,0,12"/>
                                    <WrapPanel>
                                        <Button x:Name="RefreshButton" Content="Обновить" Click="RefreshProfile" Margin="0,0,7,6"/>
                                        <Button x:Name="RemoveButton" Content="Удалить" Click="RemoveProfile" Margin="0,0,0,6"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Добавить источник"/>
                                    <TextBlock Style="{StaticResource Label}" Text="Ключ или URL подписки"/>
                                    <PasswordBox x:Name="SourceBox" MaxLength="65536" AutomationProperties.Name="Ключ или URL подписки"
                                                 Margin="0,0,0,13"/>
                                    <TextBlock Style="{StaticResource Label}" Text="Название (необязательно)"/>
                                    <TextBox x:Name="NameBox" MaxLength="100" AutomationProperties.Name="Название источника"/>
                                    <Button x:Name="ImportButton" Content="Добавить" Click="ImportProfile"
                                            HorizontalAlignment="Left" Margin="0,15,0,0" Style="{StaticResource PrimaryButton}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="CabinetPage" Visibility="Collapsed" AutomationProperties.Name="Страница аккаунта">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Аккаунт"/>
                        <Border Style="{StaticResource Card}" MaxWidth="530" HorizontalAlignment="Stretch">
                            <StackPanel>
                                <StackPanel x:Name="CabinetLoginForm">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Вход в Peregar vpn Cabinet"/>
                                    <TextBlock Style="{StaticResource Label}" Text="Email"/>
                                    <TextBox x:Name="CabinetEmailBox" MaxLength="254"
                                             AutomationProperties.Name="Email" Margin="0,0,0,14"/>
                                    <TextBlock Style="{StaticResource Label}" Text="Пароль"/>
                                    <PasswordBox x:Name="CabinetPasswordBox" MaxLength="128"
                                                 AutomationProperties.Name="Пароль" KeyDown="CabinetPasswordKeyDown"/>
                                    <WrapPanel Margin="0,15,0,0">
                                        <Button Content="Войти" Style="{StaticResource PrimaryButton}"
                                                Click="LoginCabinetEmail" Margin="0,0,7,6"/>
                                        <Button Content="Войти через Telegram" Click="LoginCabinetTelegram" Margin="0,0,0,6"/>
                                    </WrapPanel>
                                </StackPanel>
                                <StackPanel x:Name="CabinetAccountActions" Visibility="Collapsed">
                                    <TextBlock x:Name="CabinetAccountName" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                                    <WrapPanel>
                                        <Button x:Name="SyncCabinetButton" Content="Обновить подписки"
                                                Click="RefreshCabinet" Margin="0,0,7,6"/>
                                        <Button x:Name="SignOutCabinetButton" Content="Выйти" Click="SignOutCabinet" Margin="0,0,0,6"/>
                                    </WrapPanel>
                                </StackPanel>
                                <Button x:Name="CancelTelegramLoginButton" Content="Отменить вход"
                                        Click="CancelTelegramLogin" Visibility="Collapsed" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="CabinetStatus" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                                           AutomationProperties.LiveSetting="Polite" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="RoutingPage" Visibility="Collapsed" AutomationProperties.Name="Страница маршрутизации">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Маршрутизация"/>
                        <StackPanel x:Name="RoutingEditor">
                            <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                <Button x:Name="RoutingApply" DockPanel.Dock="Right" Content="Применить"
                                        Style="{StaticResource PrimaryButton}" Click="ApplyRoutingProfile" Margin="10,0,0,0"
                                        ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Применить профиль"/>
                                <Button x:Name="RoutingProfileMenu" DockPanel.Dock="Right" Content="•••"
                                        Style="{StaticResource RouteAction}" Click="OpenRoutingProfileMenu" Margin="8,0,0,0"
                                        AutomationProperties.Name="Действия с профилем" ToolTip="Действия с профилем">
                                    <Button.ContextMenu>
                                        <ContextMenu Background="{DynamicResource Panel}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}">
                                            <MenuItem Header="Новый профиль" Click="NewRoutingProfile"/>
                                            <MenuItem Header="Переименовать" Click="RenameRoutingProfile"/>
                                            <Separator/>
                                            <MenuItem Header="Импорт…" Click="ImportRoutingProfile"/>
                                            <MenuItem Header="Экспорт…" Click="ExportRoutingProfile"/>
                                            <Separator/>
                                            <MenuItem x:Name="RoutingDeleteProfile" Header="Удалить профиль" Click="DeleteRoutingProfile"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <ComboBox x:Name="RoutingProfileBox" Style="{StaticResource RoutingSelect}" DisplayMemberPath="Name"
                                          SelectionChanged="RoutingProfileChanged" AutomationProperties.Name="Профиль маршрутизации"/>
                            </DockPanel>
                            <TextBlock x:Name="RoutingActiveLabel" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,11"/>
                            <CheckBox x:Name="RoutingSubscriptionToggle" Content="Правила подписки"
                                      Style="{StaticResource SettingToggle}" Click="ToggleSubscriptionRouting"
                                      ToolTip="Изменение вступит в силу после нажатия «Применить»." Margin="0,0,0,12"/>
                        </StackPanel>
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                            <WrapPanel>
                                <RadioButton x:Name="RoutingRulesTab" GroupName="RoutingTabs" Content="Правила" Style="{StaticResource RouteTab}" Checked="RoutingTabChanged"/>
                                <RadioButton x:Name="RoutingGroupsTab" GroupName="RoutingTabs" Content="Группы" Style="{StaticResource RouteTab}" Checked="RoutingTabChanged"/>
                                <RadioButton x:Name="RoutingConnectionsTab" GroupName="RoutingTabs" Content="Соединения" Style="{StaticResource RouteTab}" Checked="RoutingTabChanged"/>
                            </WrapPanel>
                        </Border>
                        <StackPanel x:Name="RoutingRulesPane" Margin="0,12,0,0">
                            <DockPanel LastChildFill="True">
                                <Button x:Name="RoutingAddRule" DockPanel.Dock="Right" Style="{StaticResource RouteAction}" Click="AddRoutingRule" Margin="9,0,0,0"
                                        AutomationProperties.Name="Добавить правило">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource LucidePlus}" Stroke="{DynamicResource Accent}" Margin="0,0,7,0" Width="14" Height="14"/>
                                        <TextBlock Text="Добавить правило"/>
                                    </StackPanel>
                                </Button>
                                <Grid>
                                    <TextBox x:Name="RoutingRuleFilter" Height="38" MinHeight="0" Padding="12,8" MaxLength="256" VerticalContentAlignment="Center"
                                             TextChanged="RoutingFilterChanged" AutomationProperties.Name="Поиск по правилам">
                                        <TextBox.Template>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border x:Name="SearchSurface" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ScrollViewer x:Name="PART_ContentHost"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="SearchSurface" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </TextBox.Template>
                                    </TextBox>
                                    <TextBlock Text="Поиск по правилам" Foreground="{DynamicResource Muted}" Margin="13,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=RoutingRuleFilter}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DockPanel>
