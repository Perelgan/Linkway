<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>VPNDesktop.Bootstrap</StartupObject>
    <Version>1.4.0-beta.17</Version>
    <Product>Linkway</Product>
    <AssemblyTitle>Linkway</AssemblyTitle>
    <ApplicationIcon>Assets/Linkway.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <Resource Include="Assets/Linkway.ico" />
    <Resource Include="Assets/Linkway.png" />
    <EmbeddedResource Include="Assets/country-flags-w40.zip" LogicalName="VPNDesktop.CountryFlags.zip" />
  </ItemGroup>

</Project>
