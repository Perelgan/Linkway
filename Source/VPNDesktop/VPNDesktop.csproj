<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>VPNDesktop.Bootstrap</StartupObject>
    <Version>1.3.2</Version>
    <Product>Linkway</Product>
    <AssemblyTitle>Linkway</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <EmbeddedResource Include="Assets/country-flags-w40.zip" LogicalName="VPNDesktop.CountryFlags.zip" />
  </ItemGroup>

</Project>
